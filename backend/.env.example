PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# ── Required ──────────────────────────────────────────────────────────
# Convex — https://dashboard.convex.dev
# CONVEX_ADMIN_KEY is a production deploy key. Set it locally and on Render.
# Never commit the value. Rotate if it was ever in git.
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_ADMIN_KEY=

# JWT — at least 64 random characters
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_secret_min_64_chars

# ── Public site URLs ─────────────────────────────────────────────────
# Customer site origin (password-reset / booking email links). No trailing slash.
FRONTEND_URL=http://localhost:5173

# CORS — comma-separated allowed origins in production (exact match, no trailing slash).
CORS_ORIGINS=https://www.phoenixadventures.in,https://admin.phoenixadventures.in
# CORS_ALLOW_VERCEL_PREVIEWS=false

# Auth cookies — production on Render with Vercel SPAs (cross-site):
#   COOKIE_SAME_SITE=none
#   Leave COOKIE_DOMAIN unset while API host is *.onrender.com
# When API moves to api.<your-domain>, optional: COOKIE_DOMAIN=.<your-domain>
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.phoenixadventures.in

# Cloudinary — image uploads (required for adventure photos / avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
ADMIN_EMAIL=admin@example.com
# ADMIN_WHATSAPP=919999999999
# BOOKING_CUTOFF_HOURS=3

# Admin 2FA (TOTP). Leave false for local login without an authenticator.
ADMIN_REQUIRE_2FA=false
ADMIN_2FA_RESET_KEY=replace_with_long_random_secret_min_16_chars
# ENCRYPTION_KEY=

# ── One-time admin seed (node seedAdmin.js) ──────────────────────────
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace_with_strong_password_min_8_chars
# SEED_ADMIN_NAME=Phoenix Admin

# ── Optional ─────────────────────────────────────────────────────────
# OPENAI_API_KEY=   # admin itinerary / PDF helpers; leave unset if unused

# WhatsApp Cloud API
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_USE_TEXT=true
# WHATSAPP_TEMPLATE_NAME=booking_confirmed
# WHATSAPP_TEMPLATE_LANG=en

# Redis (not required for Render launch — leave unset unless you run Redis)
# REDIS_URL=redis://127.0.0.1:6379
# ENABLE_INLINE_WORKER=true
# REQUIRE_REDIS=false
# JOB_CONCURRENCY=5
# CACHE_TTL_ADVENTURES=120
# CACHE_TTL_ADVENTURE_DETAIL=180
# CACHE_TTL_SETTINGS=120

# Sliding idle timeout (minutes). Staff default 45; members 0 = off.
# ADMIN_IDLE_MINUTES=45
# USER_IDLE_MINUTES=0

# Cloudflare Access (optional)
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
# REQUIRE_CF_ACCESS=false
