PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# ── Required ──────────────────────────────────────────────────────────
# Convex — https://dashboard.convex.dev
CONVEX_URL=your_convex_deployment_url
CONVEX_ADMIN_KEY=your_convex_admin_key

# JWT — at least 64 random characters
JWT_SECRET=your_strong_random_jwt_secret_min_64_chars

# ── Public site URLs ─────────────────────────────────────────────────
# Customer site origin (password-reset / booking email links). No trailing slash.
# Production (Hostinger domain on Vercel):
#   FRONTEND_URL=https://www.phoenixadventures.in
FRONTEND_URL=http://localhost:5173

# ── Admin seeding (one-time) ─────────────────────────────────────────
# Run once: node seedAdmin.js
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_strong_password_min_8_chars
SEED_ADMIN_NAME=Phoenix Admin

# ── Optional features ────────────────────────────────────────────────
# OpenAI — admin AI helpers (itinerary optimizer, PDF extractor)
OPENAI_API_KEY=your_openai_api_key

# Cloudinary — image uploads for adventures & avatars, and public raw URLs
# for itinerary PDFs attached on WhatsApp after payment confirmation
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS — comma-separated allowed origins in production (exact match, no trailing slash).
# Include every browser origin that calls the API:
#   custom domain (www + admin) AND the Vercel production URLs (*.vercel.app)
# Example:
#   CORS_ORIGINS=https://www.phoenixadventures.in,https://admin.phoenixadventures.in,https://phoenix-frontend.vercel.app,https://phoenix-admin.vercel.app
# Vercel PR previews are extra origins (https://<project>-<hash>-<team>.vercel.app).
# Either add those URLs here, or set CORS_ALLOW_VERCEL_PREVIEWS=true (staging only —
# any https://*.vercel.app host can then call the API with credentials).
CORS_ORIGINS=https://www.phoenixadventures.in,https://admin.phoenixadventures.in
# CORS_ALLOW_VERCEL_PREVIEWS=false

# Auth cookies (httpOnly session). Vercel SPAs + API on Render/Koyeb = cross-site:
#   COOKIE_SAME_SITE=none   (required; also needs Secure — automatic when NODE_ENV=production)
# Do NOT set COOKIE_DOMAIN unless the API is on a sibling host, e.g. api.phoenixadventures.in.
# If API stays on *.onrender.com / *.koyeb.app, leave COOKIE_DOMAIN unset.
# COOKIE_DOMAIN=.phoenixadventures.in
# COOKIE_SAME_SITE=none

# Sliding idle timeout (activity refreshes on authenticated API calls; JWT still has an absolute cap)
# Staff (admin + clerk): default 45 minutes idle, 24h absolute
ADMIN_IDLE_MINUTES=45
# Members: 7d absolute. Set USER_IDLE_MINUTES to e.g. 10080 to also idle-expire; 0 = off
USER_IDLE_MINUTES=0

# Helmet CSP extra origins (comma-separated). Cloudinary, Google Fonts, Maps, Instagram are already allowed.
# CSP_IMG_ORIGINS=https://images.example.com
# CSP_CONNECT_ORIGINS=https://api.example.com

# Admin 2FA (TOTP — Google Authenticator / Authy)
# Development: leave false so local login works without an authenticator.
# Production: set ADMIN_REQUIRE_2FA=true after at least one admin has 2FA enabled.
ADMIN_REQUIRE_2FA=false
# Long random secret for emergency 2FA reset when authenticator AND recovery codes are lost
# POST /api/auth/2fa/emergency-reset { email, password, resetKey }
# Rate limited (3/hour in production). Logged to audit + ADMIN_EMAIL.
# Or run: node scripts/resetAdmin2fa.js admin@example.com
ADMIN_2FA_RESET_KEY=replace_with_long_random_secret_min_16_chars

# Encrypt TOTP secrets at rest (AES-256-GCM). 32-byte key: 64 hex chars or base64.
# Generate locally (do not commit the result):
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Existing plaintext secrets still verify; they are encrypted on next 2FA enable.
# ENCRYPTION_KEY=

# Cloudflare Zero Trust (optional) — when API is also behind Access
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-aud-tag
# REQUIRE_CF_ACCESS=true   # production only; admin routes require Cf-Access-Jwt-Assertion

# Email — for password reset links (currently logs to console; wire later)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
ADMIN_EMAIL=admin@example.com
# ADMIN_WHATSAPP=919372506447
# BOOKING_CUTOFF_HOURS=3

# WhatsApp Cloud API — booking confirmation to customer phone (Meta Business)
# Create app at https://developers.facebook.com → WhatsApp → API Setup
# For production, approve a template in Meta Business Suite (see WHATSAPP_TEMPLATE_NAME).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# For production, approve templates in Meta Business Suite.
# WHATSAPP_USE_TEXT=false  recommended in production (templates required outside 24h window).
# Local/dev: keep true so messages still send without approved templates.
WHATSAPP_USE_TEXT=true
# WHATSAPP_TEMPLATE_NAME=booking_confirmed
# WHATSAPP_TEMPLATE_LANG=en
# Optional extra templates (body vars match job copy):
# WHATSAPP_TEMPLATE_PREDEPARTURE=trip_pre_departure
# WHATSAPP_TEMPLATE_REVIEW=trip_review_nudge
# WHATSAPP_TEMPLATE_WAITLIST=waitlist_dates

# Google Places — optional live GBP reviews (place_id ChIJBZcX2Oy35zsRXjj7MoK62as)
# TODO: enable Places Details (fields=reviews,rating,user_ratings_total) and filter rating >= 4
# GOOGLE_MAPS_API_KEY=

# ── Scaling (optional — Redis is NOT required for launch) ────────────────────
# Production on Render/Koyeb works without REDIS_URL (in-memory cache / jobs).
# Do not set REQUIRE_REDIS unless you also run Redis.
# 1. Local: docker compose up -d redis
# 2. Then:
# REDIS_URL=redis://127.0.0.1:6379
# ENABLE_INLINE_WORKER=true
# REQUIRE_REDIS=true   # only if Redis must be up for /api/health
#
# Hosting: see HOSTING.md (Hostinger DNS → Vercel www/admin → Render/Koyeb API → Convex).
# CACHE_TTL_ADVENTURES=120
# CACHE_TTL_ADVENTURE_DETAIL=180
# CACHE_TTL_SETTINGS=120
# JOB_CONCURRENCY=5

