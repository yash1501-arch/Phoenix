PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# Convex (required)
CONVEX_URL=your_convex_deployment_url
CONVEX_ADMIN_KEY=your_convex_admin_key

# Razorpay (required for payments)
# Get keys from https://dashboard.razorpay.com/app/keys
# Use Test keys (rzp_test_*) for development, Live keys (rzp_live_*) for production.
# Do NOT commit real keys to git — backend/.env is gitignored.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_with_real_secret
# Get from Settings → Webhooks → "Create new webhook" → Secret field.
# Required for verifying payment.captured and order.paid events.
RAZORPAY_WEBHOOK_SECRET=replace_me_with_webhook_secret

# JWT (required)
JWT_SECRET=your_strong_random_jwt_secret_min_64_chars

# OpenAI (optional - AI features)
OPENAI_API_KEY=your_openai_api_key

# Cloudinary (optional - image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS
CORS_ORIGINS=https://www.phoenixadventures.in,https://admin.phoenixadventures.in

# Email (optional - SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
ADMIN_EMAIL=admin@example.com
