PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# ── Required ──────────────────────────────────────────────────────────
# Convex — https://dashboard.convex.dev
CONVEX_URL=your_convex_deployment_url
CONVEX_ADMIN_KEY=your_convex_admin_key

# JWT — at least 64 random characters
JWT_SECRET=your_strong_random_jwt_secret_min_64_chars

# ── Public site URLs ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Admin seeding (one-time) ─────────────────────────────────────────
# Run once: node seedAdmin.js
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_strong_password_min_8_chars
SEED_ADMIN_NAME=Phoenix Admin

# ── Optional features ────────────────────────────────────────────────
# OpenAI — admin AI helpers (itinerary optimizer, PDF extractor)
OPENAI_API_KEY=your_openai_api_key

# Cloudinary — image uploads for adventures & avatars
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS — comma-separated allowed origins in production
CORS_ORIGINS=https://www.phoenixadventures.in,https://admin.phoenixadventures.in

# Auth cookie (httpOnly session) — set in production for cross-subdomain SPA + API
# COOKIE_DOMAIN=.phoenixadventures.in
# COOKIE_SAME_SITE=none

# Admin 2FA uses TOTP (Google Authenticator / Authy) — enable in Admin → Settings

# Cloudflare Zero Trust (optional) — when API is also behind Access
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-aud-tag
# REQUIRE_CF_ACCESS=true

# Email — for password reset links (currently logs to console; wire later)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
ADMIN_EMAIL=admin@example.com
# ADMIN_WHATSAPP=919372506447
# BOOKING_CUTOFF_HOURS=3

# WhatsApp Cloud API — booking confirmation to customer phone (Meta Business)
# Create app at https://developers.facebook.com → WhatsApp → API Setup
# For production, approve a template in Meta Business Suite (see WHATSAPP_TEMPLATE_NAME).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# Template body vars: {{1}} name {{2}} adventure {{3}} date {{4}} booking id {{5}} seats {{6}} amount
# WHATSAPP_TEMPLATE_NAME=booking_confirmed
# WHATSAPP_TEMPLATE_LANG=en
# Set true to send free-form text instead of template (test / 24h session only)
WHATSAPP_USE_TEXT=true

# Google Places — optional live GBP reviews (place_id ChIJBZcX2Oy35zsRXjj7MoK62as)
# TODO: enable Places Details (fields=reviews,rating,user_ratings_total) and filter rating >= 4
# GOOGLE_MAPS_API_KEY=

# ── Scaling (Phase 2) ────────────────────────────────────────────────────────
# 1. Start Docker Desktop, then from repo root:
#      docker compose up -d redis
# 2. Uncomment:
# REDIS_URL=redis://127.0.0.1:6379
# ENABLE_INLINE_WORKER=true
# 3. Restart backend — /api/health should show checks.redis.ok: true
# 4. Deploy frontend/admin to Vercel (vercel.json included) with VITE_API_URL
# 5. On Koyeb: set REDIS_URL, scale web to 3+ instances; optional worker service
#
# REQUIRE_REDIS=true   # production: /api/health returns 503 if Redis is down
# CACHE_TTL_ADVENTURES=120
# CACHE_TTL_ADVENTURE_DETAIL=180
# CACHE_TTL_SETTINGS=120
# JOB_CONCURRENCY=5

