{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "phoenixadventures.in" }],
      "destination": "https://www.phoenixadventures.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "phoenixadventures.in" }],
      "destination": "https://www.phoenixadventures.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.phoenixadventures.in/api/sitemap.xml" },
    {
      "source": "/adventure/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": "WhatsApp" }],
      "destination": "https://api.phoenixadventures.in/api/share/adventure/:id"
    },
    {
      "source": "/adventure/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": "facebookexternalhit" }],
      "destination": "https://api.phoenixadventures.in/api/share/adventure/:id"
    },
    {
      "source": "/adventure/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": "Facebot" }],
      "destination": "https://api.phoenixadventures.in/api/share/adventure/:id"
    },
    {
      "source": "/adventure/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": "Twitterbot" }],
      "destination": "https://api.phoenixadventures.in/api/share/adventure/:id"
    },
    { "source": "/((?!assets/|googleabe45545923365d8\\.html|upi-merchant-qr\\.png).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/booking/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://res.cloudinary.com https://*.cloudinary.com; connect-src 'self' https://api.phoenixadventures.in; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
